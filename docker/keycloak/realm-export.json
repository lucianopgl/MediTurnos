{
  "id": "mediturnos-realm-id",
  "realm": "MediTurnos",
  "displayName": "MediTurnos API — Gestión de Turnos y Recursos (UTN FRC)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "ROL_ADMIN",
        "description": "Administrador general del catálogo de sedes, consultorios, equipamientos y supervisión de reservas"
      },
      {
        "name": "ROL_PROFESIONAL",
        "description": "Profesional de la salud: parametrización de plantillas horarias, bloqueos de agenda y cierre de atención"
      },
      {
        "name": "ROL_PACIENTE",
        "description": "Paciente: autogestión de reservas, pagos, cancelaciones y reprogramación prioritaria"
      }
    ]
  },
  "clients": [
    {
      "clientId": "mediturnos-client",
      "name": "MediTurnos REST Client (Gateway / Postman / Bruno)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8080/*",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "sub-claim-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
