# =============================================================================
# MediTurnos API — Plantilla de Variables de Entorno (.env.example)
# Copiar este archivo como `.env` para la ejecución local con Docker Compose
# =============================================================================

# Perfil de ejecución de Spring Boot dentro de los contenedores
SPRING_PROFILES_ACTIVE=docker

# Puertos expuestos al sistema operativo Host
GATEWAY_PORT=8080
KEYCLOAK_PORT=8083
POSTGRES_PORT=5432

# Configuración de PostgreSQL 16 (Instancia única con schema_catalogo y schema_reservas)
POSTGRES_DB=mediturnos_db
POSTGRES_USER=mediturnos_user
POSTGRES_PASSWORD=mediturnos_pass

# Configuración de Keycloak 24 (Identity Provider OIDC / JWT)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# API Pública Externa de Mensajería/Notificaciones (RN-08: Resiliencia ante fallos)
NOTIFICACIONES_API_URL=https://api.telegram.org
NOTIFICACIONES_BOT_TOKEN=reemplazar_con_token_de_prueba_o_mock
