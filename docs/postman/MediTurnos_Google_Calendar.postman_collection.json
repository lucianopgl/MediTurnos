      "item": [
        {
          "name": "01. Cancelar turno por el paciente (FUNC-09)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK y turno cancelado\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().estado).to.include(\"CANCELADO\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{paciente_perez_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/reservas/turnos/{{gc_turno_id}}/cancelacion",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "reservas",
                "turnos",
                "{{gc_turno_id}}",
                "cancelacion"
              ]
            }
          }
        },
        {
          "name": "02. Auditoría: GOOGLE_CALENDAR / CANCELACION = ENVIADO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var turnoId = Number(pm.collectionVariables.get(\"gc_turno_id\"));",
                  "var filas = pm.response.json().filter(function (n) { return n.turnoId === turnoId; });",
                  "var gc = filas.filter(function (n) { return n.canal === \"GOOGLE_CALENDAR\" && n.tipoAlerta === \"CANCELACION\"; });",
                  "var tg = filas.filter(function (n) { return n.canal === \"TELEGRAM\" && n.tipoAlerta === \"CANCELACION\"; });",
                  "",
                  "pm.test(\"Se registró 1 notificación GOOGLE_CALENDAR en estado ENVIADO\", function () {",
                  "    pm.expect(gc.length, \"filas GOOGLE_CALENDAR\").to.eql(1);",
                  "    pm.expect(gc[0].estadoEnvio).to.eql(\"ENVIADO\");",
                  "});",
                  "pm.test(\"El destinatario es el email del paciente y el detalle referencia el evento del turno\", function () {",
                  "    pm.expect(gc[0].destinatario).to.include(\"@\");",
                  "    pm.expect(gc[0].detalleMensaje).to.include(String(turnoId));",
                  "});",
                  "pm.test(\"Telegram sigue notificando en paralelo (sin regresión)\", function () {",
                  "    pm.expect(tg.length, \"filas TELEGRAM\").to.eql(1);",
                  "});",
                  "if (gc.length && gc[0].detalleMensaje.indexOf(\"[SIMULADO]\") >= 0) {",
                  "    console.log(\"Google Calendar en modo SIMULADO (GOOGLE_CALENDAR_ENABLED=false): no se envió el mail real.\");",
                  "}",
                  "pm.test(\"El detalle indica que el evento fue cancelado\", function () {",
                  "    pm.expect(gc[0].detalleMensaje).to.include(\"Evento cancelado\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/reservas/notificaciones?pacienteId=1",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "reservas",
                "notificaciones"
              ],
              "query": [
                {
                  "key": "pacienteId",
                  "value": "1"
                }
              ]
            },
            "description": "Audita las notificaciones del turno de la prueba luego de: la cancelación."
          }
        }
