    {
      "name": "01. Reserva → crea evento e invitación por email",
      "item": [
        {
          "name": "01. Reservar turno (FUNC-07)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha y franja aleatorias (día hábil entre 30 y 300 días, 08:00-13:30) para que la colección",
                  "// se pueda correr varias veces sin colisiones ni chocar con bloqueos de corridas anteriores.",
                  "function siguienteDiaHabil(d) {",
                  "    var r = new Date(d.getTime());",
                  "    while (r.getDay() === 0 || r.getDay() === 6) { r.setDate(r.getDate() + 1); }",
                  "    return r;",
                  "}",
                  "function fmtFecha(d) {",
                  "    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
                  "}",
                  "var base = new Date();",
                  "base.setDate(base.getDate() + 30 + Math.floor(Math.random() * 270));",
                  "var fechaTurno = siguienteDiaHabil(base);",
                  "var fechaReprog = new Date(fechaTurno.getTime());",
                  "fechaReprog.setDate(fechaReprog.getDate() + 1);",
                  "fechaReprog = siguienteDiaHabil(fechaReprog);",
                  "var slot = Math.floor(Math.random() * 12); // 12 franjas de 30 min entre 08:00 y 14:00",
                  "var h = 8 + Math.floor(slot / 2), m = (slot % 2) * 30;",
                  "var hora = String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':00';",
                  "var fin = new Date(2000, 0, 1, h, m + 30);",
                  "var horaFin = String(fin.getHours()).padStart(2, '0') + ':' + String(fin.getMinutes()).padStart(2, '0') + ':00';",
                  "pm.collectionVariables.set(\"gc_fecha\", fmtFecha(fechaTurno));",
                  "pm.collectionVariables.set(\"gc_hora\", hora);",
                  "pm.collectionVariables.set(\"gc_hora_fin\", horaFin);",
                  "pm.collectionVariables.set(\"gc_fecha_reprog\", fmtFecha(fechaReprog));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Turno RESERVADO (la notificación nunca bloquea la reserva - RN-08)\", function () {",
                  "    var t = pm.response.json();",
                  "    pm.expect(t.estado).to.eql(\"RESERVADO\");",
                  "    pm.collectionVariables.set(\"gc_turno_id\", t.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{paciente_perez_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/reservas/turnos",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "reservas",
                "turnos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"profesionalId\": 1,\n    \"servicioId\": 1,\n    \"fecha\": \"{{gc_fecha}}\",\n    \"horaInicio\": \"{{gc_hora}}\"\n}"
            }
          }
        },
        {
          "name": "02. Auditoría: GOOGLE_CALENDAR / RESERVA = ENVIADO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var turnoId = Number(pm.collectionVariables.get(\"gc_turno_id\"));",
                  "var filas = pm.response.json().filter(function (n) { return n.turnoId === turnoId; });",
                  "var gc = filas.filter(function (n) { return n.canal === \"GOOGLE_CALENDAR\" && n.tipoAlerta === \"RESERVA\"; });",
                  "var tg = filas.filter(function (n) { return n.canal === \"TELEGRAM\" && n.tipoAlerta === \"RESERVA\"; });",
                  "",
                  "pm.test(\"Se registró 1 notificación GOOGLE_CALENDAR en estado ENVIADO\", function () {",
                  "    pm.expect(gc.length, \"filas GOOGLE_CALENDAR\").to.eql(1);",
                  "    pm.expect(gc[0].estadoEnvio).to.eql(\"ENVIADO\");",
                  "});",
                  "pm.test(\"El destinatario es el email del paciente y el detalle referencia el evento del turno\", function () {",
                  "    pm.expect(gc[0].destinatario).to.include(\"@\");",
                  "    pm.expect(gc[0].detalleMensaje).to.include(String(turnoId));",
                  "});",
                  "pm.test(\"Telegram sigue notificando en paralelo (sin regresión)\", function () {",
                  "    pm.expect(tg.length, \"filas TELEGRAM\").to.eql(1);",
                  "});",
                  "if (gc.length && gc[0].detalleMensaje.indexOf(\"[SIMULADO]\") >= 0) {",
                  "    console.log(\"Google Calendar en modo SIMULADO (GOOGLE_CALENDAR_ENABLED=false): no se envió el mail real.\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/reservas/notificaciones?pacienteId=1",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "reservas",
                "notificaciones"
              ],
              "query": [
                {
                  "key": "pacienteId",
                  "value": "1"
                }
              ]
            },
            "description": "Audita las notificaciones del turno de la prueba luego de: la reserva."
          }
        }
      ]
    },
