        {
          "name": "06. Validación de Compatibilidad Estática (RN-01, RN-02)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Calcular fecha habil siguiente para no caer en fin de semana",
                  "var d = new Date();",
                  "d.setDate(d.getDate() + 1);",
                  "if (d.getDay() === 0) d.setDate(d.getDate() + 1);",
                  "if (d.getDay() === 6) d.setDate(d.getDate() + 2);",
                  "var yyyy = d.getFullYear();",
                  "var mm = String(d.getMonth() + 1).padStart(2, '0');",
                  "var dd = String(d.getDate()).padStart(2, '0');",
                  "pm.environment.set(\"fecha_compatibilidad\", yyyy + '-' + mm + '-' + dd);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Compatibilidad confirmada para Dr. González y Box 101\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.compatible).to.be.true;",
                  "    pm.expect(jsonData.consultorioId).to.eql(1);",
                  "    pm.expect(jsonData.costo).to.eql(15000.0);",
                  "    pm.expect(jsonData.equipamientoIds).to.include(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{paciente_perez_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/catalogo/compatibilidad?profesionalId=1&servicioId=1&fecha={{fecha_compatibilidad}}&horaInicio=09:00:00&horaFin=09:30:00",
              "host": [
                "{{gateway_url}}"
              ],
