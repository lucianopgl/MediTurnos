    {
      "name": "01. Seguridad Perimetral Gateway y Trazabilidad (CV-08)",
      "description": "Verificaciones de seguridad en el perímetro reactivo del Gateway: paso libre a /actuator/health, rechazo 401 Unauthorized sin token e inyección de ErrorResponseDTO, rechazo 403 Forbidden por roles insuficientes y propagación de X-Correlation-Id.",
      "item": [
        {
          "name": "01. Paso Libre Actuator Health (Público sin token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Gateway Actuator está UP\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/actuator/health",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          }
        },
        {
          "name": "02. CV-08 (401): Rechazo sin Token y ErrorResponseDTO",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Formato unificado ErrorResponseDTO y Header X-Correlation-Id presente\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.codigo).to.eql(\"ACCESO_NO_AUTORIZADO\");",
                  "    pm.expect(jsonData.status).to.eql(401);",
                  "    pm.expect(jsonData.timestamp).to.be.a(\"string\");",
                  "    pm.expect(jsonData.path).to.be.a(\"string\");",
                  "    pm.expect(pm.response.headers.has(\"X-Correlation-Id\")).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/catalogo/sedes",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "catalogo",
                "sedes"
              ]
            }
          }
        },
        {
          "name": "03. CV-08 (403): Paciente intentando crear Sede",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"ErrorResponseDTO deniega acceso a ROL_PACIENTE\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.codigo).to.eql(\"ACCESO_DENEGADO\");",
                  "    pm.expect(jsonData.status).to.eql(403);",
                  "    pm.expect(pm.response.headers.has(\"X-Correlation-Id\")).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{paciente_perez_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Sede Ilegal No Autorizada\",\n    \"direccion\": \"Calle Falsa 123\",\n    \"activa\": true\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/catalogo/sedes",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "catalogo",
                "sedes"
              ]
            }
          }
        },
        {
          "name": "04. CV-08 (403): Paciente intentando auditar Notificaciones",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"ErrorResponseDTO deniega ruta exclusiva ROL_ADMIN\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.codigo).to.eql(\"ACCESO_DENEGADO\");",
                  "    pm.expect(jsonData.status).to.eql(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{paciente_perez_token}}"
              }
            ],
            "url": {
