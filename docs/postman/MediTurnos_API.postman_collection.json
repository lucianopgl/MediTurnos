    {
      "name": "03. Ciclo Transaccional de Turnos (ms-reservas - 8082)",
      "description": "Casos de verificación nucleares de la cátedra: reserva tripartita exitosa (CV-01), detección de colisión de consultorio compartido (CV-02), bloqueo por recurso no disponible (CV-03), confirmación por pago (CV-04), bloqueo de agenda médica (CV-06), reprogramación prioritaria sin doble cobro (CV-07), cancelación con liberación inmediata (CV-05) y cierre clínico (FUNC-11).",
      "item": [
        {
          "name": "01. CV-01: Reserva Exitosa Tripartita (RN-01, RN-02, RN-03, RN-08)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generar fecha y horario unico para la prueba",
                  "var d = new Date();",
                  "d.setDate(d.getDate() + 3);",
                  "if (d.getDay() === 0) d.setDate(d.getDate() + 1);",
                  "if (d.getDay() === 6) d.setDate(d.getDate() + 2);",
                  "var yyyy = d.getFullYear();",
                  "var mm = String(d.getMonth() + 1).padStart(2, '0');",
                  "var dd = String(d.getDate()).padStart(2, '0');",
                  "pm.environment.set(\"fecha_cv01\", yyyy + '-' + mm + '-' + dd);",
                  "pm.environment.set(\"hora_cv01\", \"09:00:00\");",
                  "pm.environment.set(\"hora_fin_cv01\", \"09:30:00\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Turno creado en estado RESERVADO sin pagar\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "    pm.expect(jsonData.estado).to.eql(\"RESERVADO\");",
                  "    pm.expect(jsonData.pagado).to.be.false;",
                  "    pm.expect(jsonData.costoAcordado).to.eql(15000.0);",
                  "    pm.environment.set(\"turno_cv01_id\", jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{paciente_perez_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"pacienteId\": 1,\n    \"profesionalId\": 1,\n    \"servicioId\": 1,\n    \"fecha\": \"{{fecha_cv01}}\",\n    \"horaInicio\": \"{{hora_cv01}}\",\n    \"motivoConsulta\": \"Chequeo Preventivo Postman Suite\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/reservas/turnos",
