    {
      "name": "04. Auditoría, Trazabilidad y Diagnóstico",
      "description": "Auditoría de notificaciones externas resilientes (RN-08), persistidas con su estado de envío y trazabilidad distribuida mediante cabecera X-Correlation-Id.",
      "item": [
        {
          "name": "01. Auditoría de Notificaciones con X-Correlation-Id (RN-08, INT-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Notificaciones registradas con X-Correlation-Id y estado de envio\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.at.least(1);",
                  "    var notif = jsonData[0];",
                  "    pm.expect(notif.correlationId).to.be.a('string');",
                  "    pm.expect(notif.canal).to.be.a('string');",
                  "    pm.expect(notif.estadoEnvio).to.be.oneOf([\"ENVIADO\", \"ERROR\"]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/reservas/notificaciones?profesionalId=1",
              "host": [
